{
  "name": "dsh-project-std",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：AI 辅助开发的项目管理标准——标准正文以技能分发、std-check 机械检查器、受控动作询问。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alan-IFT/dsh-project-std.git"
  },
  "homepage": "https://github.com/Alan-IFT/dsh-project-std#readme",
  "bugs": {
    "url": "https://github.com/Alan-IFT/dsh-project-std/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config_plugin.d.ts",
      "default": "./lib/config_plugin.js"
    },
    "./skills": {
      "types": "./lib/skills_plugin.d.ts",
      "default": "./lib/skills_plugin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "std-check": "lib/cli.js"
  },
  "files": [
    "lib",
    "skills",
    "tools/std/CONTRACT.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "templates/WORK_ITEM.md",
    "LICENSE-DOCS"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "check:lib": "node scripts/check-lib-sync.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "guard",
    "standard",
    "project-management"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-0 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.0-rc.2"
  }
}
